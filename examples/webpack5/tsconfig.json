{
  "compilerOptions": {
    "composite": true,
    "target": "es5",
    "module": "esnext",
    "moduleResolution": "node",
    "types": ["../common/typings.d.ts"],
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["webpack.config.ts"]
}
